import os
import json
import difflib
import re
from rdflib import Graph, Literal, Namespace, RDF, URIRef
from pyshacl import validate
from graphviz import Digraph
import hashlib
import textwrap

class RDFLibConverter:
    """
    Converts LLM-generated JSON-LD into a structured RDFLib Graph
    and validates it against the RiC-O Ontology and SHACL shapes.
    """
    # Official Namespaces
    RICO = Namespace("https://www.ica.org/standards/RiC/ontology#")
    BASE = Namespace("http://udl.cat/archive/")
    #BASE = Namespace("http://example.org/archive/")

    def __init__(self, ontology_data_path="/algorithm/src/RiC_Ontology/RiC-O_1-1_schema.json"):
        self.ontology_data_path = ontology_data_path
        
        if os.path.exists(self.ontology_data_path):
            with open(self.ontology_data_path, 'r', encoding='utf-8') as f:
                ontology_data = json.load(f)
                self.valid_classes = set(ontology_data.get('classes', []))
                self.valid_properties = set(ontology_data.get('properties', []))
        else:
            raise FileNotFoundError(f"Ontology data not found: {self.ontology_data_path}")
       
    def clean_json(self, raw_data):
        """Cleans and standardizes the input JSON-LD structure."""
        
        if not isinstance(raw_data, str):
            raise ValueError("Input JSON must be a string")

        start = raw_data.find('{')
        end = raw_data.rfind('}') 

        if start == -1 or end == -1 or start >= end:
            raise ValueError("Input string does not contain valid JSON object")
        
        cleaned_json = raw_data[start:end+1]

        try: 
            ric_dict = json.loads(cleaned_json)
        except json.JSONDecodeError as e:
            raise ValueError(f"Error parsing JSON: {e}")
        
        return ric_dict
    
    def to_camel_case(self, text, upper=False):
        words = re.findall(r'[a-zA-Z0-9]+', text)
        if not words: return text

        if upper: # UpperCamelCase - entities
            if len(words) == 1: return text
            else: 
               return "".join(word.capitalize() for word in words)
        else: # lowerCamelCase - attributes and relationships 
            if len(words) == 1 and words[0][0].islower(): return text
            else: 
               first_word = words[0].lower()
               return first_word + "".join(word.capitalize() for word in words[1:])

    def json_to_rdflib_graph(self, raw_llm_output):
        """
        Converts LLM JSON output into an RDFLib Graph.
        """
        # Get cleaned json
        data = self.clean_json(raw_llm_output)

        g = Graph()
        g.bind("rico", self.RICO)
        g.bind("udl", self.BASE)
        #g.bind("ex", self.BASE)

        all_json_ids = []
        for entities in data.values():
            for e in entities: 
                eid = e.get("@id", "")
                if eid.isdigit(): all_json_ids.append(int(eid))
        current_max_id = max(all_json_ids) if all_json_ids else 0 

        processed_ids = set()
        for entity_class, entities in data.items():
            for entity in entities:
                eid = entity.get("@id", "")
                        
                if eid in processed_ids:
                    current_max_id += 1
                    eid = str(current_max_id).zfill(3)
                    entity["@id"] = eid
                
                processed_ids.add(eid)

                # 1. Create Subject (URI based on @id)
                subject = self.BASE[entity["@id"]]
                
                # 2. Assign Class (@type)
                # Note: Uses UpperCamelCase 
                clean_class = self.to_camel_case(entity["@type"], upper=True)
                g.add((subject, RDF.type, self.RICO[clean_class]))

                # 3. Process Attributes and Relationships
                for key, value in entity.items():
                    if key in ["@id", "@type"]:
                        continue
                    
                    # Clean prefix if the LLM included it in the key name
                    prop_name = self.to_camel_case(key.replace("rico:", ""), upper=False)
                    predicate = self.RICO[prop_name]

                    # Value Treatment
                    if isinstance(value, str) and value.isdigit() and len(value) == 3:
                        # If it's a 3-digit ID, we treat it as an Object Relation (URI)
                        g.add((subject, predicate, self.BASE[value]))
                    elif isinstance(value, list):
                        for item in value:
                            obj = self.BASE[item] if (isinstance(item, str) and item.isdigit()) else Literal(item)
                            g.add((subject, predicate, obj))
                    else:
                        # Default to Literal (text/data)
                        g.add((subject, predicate, Literal(value)))
        return g

    def validate_and_report(self, data_graph):
        """
        Validates the graph against SHACL and flags properties 
        that do not exist in the official RiC-O ontology.
        """
        # Basic integrity rules for RiC-O rdf
        shapes_graph = f"""
        @prefix sh: <http://www.w3.org/ns/shacl#> .
        @prefix rico: <{self.RICO}> .
        @prefix udl: <{self.BASE}> .

        udl:RecordResourceShape
            a sh:NodeShape ;
            sh:targetClass rico:Record, rico:RecordSet ;
            sh:or (
                [
                   sh:path rico:identifier ;
                   sh:minCount 1 ;
                ]
                [
                   sh:path rico:name ;
                   sh:minCount 1 ;
                ]
            );
            sh:message "Missing mandatory identification: Every Record or RecordSet must have at least an identifier or a name." .
        """

        conforms, _, results_text = validate(
            data_graph,
            shacl_graph=shapes_graph,
            inference='rdfs', # Uses the ontology hierarchy
            abort_on_first=False
        )

        # Generate suggestions for nomenclature errors
        suggestions = []
        ontology_errors_found = False
        
        # Entities validation
        for s, p, o in data_graph.triples((None, RDF.type, None)):
            if str(o).startswith(str(self.RICO)):
                class_name = str(o).split("#")[-1]
                if class_name not in self.valid_classes:
                    ontology_errors_found = True
                    match = difflib.get_close_matches(class_name, list(self.valid_classes), n=1, cutoff=0.6)
                    msg = f"Entity Class 'rico:{class_name}' invalid."
                    if match:
                        msg += f"Try 'rico:{match[0]}'"
                    suggestions.append(msg)

        # Attributes and relationships validation 
        for p in data_graph.predicates():
            name = str(p).split("#")[-1]
            if str(p).startswith(str(self.RICO)) and name not in self.valid_properties:
                ontology_errors_found = True
                match = difflib.get_close_matches(name, self.valid_properties, n=1, cutoff=0.6)
                msg = f"Property 'rico:{name}' invalid."
                if match:
                    msg += f"Try 'rico:{match[0]}'"
                suggestions.append(msg)
        
        
        # We return the output even if it's not perfect
        is_valid = conforms and (not ontology_errors_found)
        
        final_report = "--- SHACL REPORT ---\n" + results_text
        if suggestions:
            final_report += "\n\n--- ONTOLOGY SUGGESTIONS (RiC-O 1.1) ---\n" + "\n".join(suggestions)
        
        return is_valid, final_report
    

    def visualize_graph(self, g, output_path):
        """
        Simple RDF to Graphviz visualization
        """

        safe_ids = {}

        def sid(uri):
            if uri not in safe_ids:
                safe_ids[uri] = "n_" + hashlib.md5(uri.encode()).hexdigest()
            return safe_ids[uri]

        def wrap_text(text, width=50):
            wrapped = textwrap.wrap(str(text), width)
            return "<BR/>".join(wrapped)
        
        path_str = str(output_path)
        if path_str.endswith(".png"):
            path_str = path_str[:-4]

        dot = Digraph(format="png", engine="dot")
        dot.attr(rankdir="LR", overlap="false", splines="true")

        nodes = {}

        # Structure
        for s, p, o in g:
            s = str(s)
            p_name = str(p).split("#")[-1]

            if s not in nodes:
                nodes[s] = {"type": "Resource", "attrs": [], "rels": []}

            if p == RDF.type:
                nodes[s]["type"] = str(o).split("#")[-1]

            elif isinstance(o, Literal):
                val = str(o)
                if len(val) > 60:
                    val = val[:60] + "..."
                nodes[s]["attrs"].append(f"{p_name}: {val}")

            else:
                nodes[s]["rels"].append((p_name, str(o)))

        # Nodes
        for uri, data in nodes.items():

            label = uri.split("/")[-1]

            attrs_html = "".join(
                f"<TR><TD ALIGN='LEFT'>{a}</TD></TR>"
                for a in data["attrs"]
            )

            html = f"""<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
                <TR>
                    <TD BGCOLOR="#2C3E50">
                        <FONT COLOR="white">
                            <B>{label}</B><BR/>({data['type']})
                        </FONT>
                    </TD>
                </TR>
                {attrs_html if data["attrs"] else "<TR><TD><I>No attributes</I></TD></TR>"}
            </TABLE>
            >"""

            dot.node(sid(uri), label=html, shape="none")

        # Edges
        for uri, data in nodes.items():
            for rel, target in data["rels"]:
                if target in nodes:
                    dot.edge(sid(uri), sid(target), label=rel)

        dot.render(path_str, cleanup=True)
