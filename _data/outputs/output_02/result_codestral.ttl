 @prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
   @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

   # ====== Event (Press Release)
   <_001> a rico:Event ;
      rico:title "Budget Approval Press Release" ;
      rico:isOriginatedBy <_AuthorID> ;
      rico:hasTimeSpan <_DateID> .

   # ====== Agent (Jaume Puy i Llorens)
   <_AuthorID> a rico:Person ;
      rico:name "Jaume Puy i Llorens" ;
      rico:heldPosition <_RectorID> .

   # ====== Position (Rector of the University of Lleida)
   <_RectorID> a rico:Position ;
      rico:isHeldByOrganization <_UniversityID> .

   # ====== Thing (University of Lleida)
   <_UniversityID> a rico:Thing ;
      rico:title "University of Lleida" .

   # ====== Date (2020 Budget Approval)
   <_DateID> a rico:Date ;
      rico:dateValue "2020"^^xsd:gYear .

   # ====== Record Resource (Budget)
   <_BudgetID> a rico:RecordResource ;
      rico:title "University of Lleida 2020 Budget" ;
      rico:isAssociatedWithDate <_DateID> .

   # ====== Record (Budget Increase)
   <_IncreaseID> a rico:Record ;
      rico:title "Budget Increase" ;
      rico:hasOrHadSubject <_BudgetID> ;
      rico:hasContentValue "2.72%"^^xsd:decimal .

   # ====== Record (Funding Sources)
   <_SourcesID> a rico:Record ;
      rico:title "Funding Sources" ;
      rico:hasOrHadSubject <_BudgetID> ;
      rico:isDescribedBy <_StateSourceID>, <_AutoGovSourceID>, <_PrivateEntitiesSourceID>, <_LocalEntitiesSourceID>, <_InternationalSourcesID>.

   # ====== Record (Main Spending Areas)
   <_SpendingAreasID> a rico:Record ;
      rico:title "Main Spending Areas" ;
      rico:hasOrHadSubject <_BudgetID> ;
      rico:isDescribedBy <_PersonnelCostsID>, <_CurrentExpensesID>, <_RealAssetsInvestmentsID>, <_TransferPaymentsID>.

   # ====== Record Part (State Funding Source)
   <_StateSourceID> a rico:RecordPart ;
      rico:title "State Contribution" ;
      rico:hasContentValue "65%"^^xsd:decimal .

   # ====== Record Part (Autonomous Government of Catalonia Funding Source)
   <_AutoGovSourceID> a rico:RecordPart ;
      rico:title "Autonomous Government of Catalonia Contribution" ;
      rico:hasContentValue "17%"^^xsd:decimal .

   # ====== Record Part (Private Entities Funding Source)
   <_PrivateEntitiesSourceID> a rico:RecordPart ;
      rico:title "Private Entities Contribution" ;
      rico:hasContentValue "14%"^^xsd:decimal .

   # ====== Record Part (Local Entities Funding Source)
   <_LocalEntitiesSourceID> a rico:RecordPart ;
      rico:title "Local Entities Contribution" ;
      rico:hasContentValue "2.3%"^^xsd:decimal .

   # ====== Record Part (International Sources Funding Source)
   <_InternationalSourcesID> a rico:RecordPart ;
      rico:title "International Sources Contribution" ;
      rico:hasContentValue "<1%"^^xsd:decimal .

   # ====== Record Part (Personnel Costs Spending Area)
   <_PersonnelCostsID> a rico:RecordPart ;
      rico:title "Personnel Costs" .

   # ====== Record Part (Current Expenses on Goods and Services Spending Area)
   <_CurrentExpensesID> a rico:RecordPart ;
      rico:title "Current Expenses on Goods and Services" .

   # ====== Record Part (Investments in Real Assets Spending Area)
   <_RealAssetsInvestmentsID> a rico:RecordPart ;
      rico:title "Investments in Real Assets" .

   # ====== Record Part (Transfer Payments to Other Levels of Government Spending Area)
   <_TransferPaymentsID> a rico:RecordPart ;
      rico:title "Transfer Payments to Other Levels of Government" .

   # ===== template end