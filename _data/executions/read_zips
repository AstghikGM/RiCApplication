@algorithm.save_results
def save(
    results: ResultsT,
    base_path: Path,
):
    # markdown
    result_path = base_path / "result.md"
    with result_path.open("w", encoding="utf-8") as f:
        f.write(f"{results["pdf_markdown"]}")

    # TTL
    result_path = base_path / "result.ttl"
    with result_path.open("w", encoding="utf-8") as result_file:
        result_file.write(f"{results["ttl_output"]}")

    # JSON 
    json_path = base_path / "extraction.json" 
    with json_path.open("w", encoding="utf-8") as first_step_file:
        first_step_file.write(f"{results["json_extraction"]}")
   

